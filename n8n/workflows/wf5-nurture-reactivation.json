    {
      "parameters": {
        "operation": "getAll",
        "tableId": "jobs",
        "filterType": "string",
        "filterString": "=customer_id=eq.{{ $('Get Contact').item.json.id }}&company_id=eq.{{ $('Get Company').item.json.id }}&status=eq.done&order=scheduled_at.desc&limit=1"
      },
      "id": "6c04d887-11e0-4853-ad02-eadd3d4393f0",
      "name": "Get Last Job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1120,
        96
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst body    = $('Nurture Webhook').item.json.body;\nconst contact = $('Get Contact').item.json;\nconst company = $('Get Company').item.json;\nconst job     = $('Get Last Job').item.json;\n\nconst name       = (contact.name || '').toString();\nconst first_name = name.split(' ')[0] || name;\nconst svc        = (job && job.service_type) ? job.service_type.toString() : 'your';\n\nreturn {\n  json: {\n    first_name,\n    phone:        (contact.phone        || '').toString(),\n    email:        (contact.email        || '').toString(),\n    company_name: (company.name || '').toString(),\n    company_id:   (body.company_id      || '').toString(),\n    contact_id:   (body.contact_id      || '').toString(),\n    entry_reason: (body.entry_reason    || '').toString(),\n    service_type: svc,\n  },\n};\n"
      },
      "id": "ba245833-0a67-44c8-a2c8-bbc0b5f6e7a5",
      "name": "Build Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        96
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "jobs",
        "filterType": "string",
        "filterString": "=customer_id=eq.{{ $json.contact_id }}&company_id=eq.{{ $json.company_id }}&status=in.(unassigned,assigned)&limit=1"
      },
      "id": "26a3936f-bb61-4b8b-a063-fbb3e0fa0f0c",
      "name": "Pre-check A",
