      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst bundle = $('Build Bundle').first().json;\nconst is_booked = items.some(i => !!(i.json && i.json.id));\nreturn [{ json: { ...bundle, is_booked } }];\n"
      },
