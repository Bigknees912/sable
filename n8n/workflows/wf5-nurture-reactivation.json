    {
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst n = 3;\nconst tmpl = {\n  reschedule_decline: {\n    1: 'Hi ' + d.first_name + ', we noticed you needed to reschedule. We\\'d love to find a time that works! Call or text us anytime.',\n    2: 'Hi ' + d.first_name + ', following up \\u2014 we have openings this week for your ' + d.service_type + ' service. Let us know!',\n    3: 'Hi ' + d.first_name + ', last check-in \\u2014 we\\'d love to get your ' + d.service_type + ' taken care of. Call or text. \\u2013 ' + d.company_name,\n  },\n  negative_feedback_resolved: {\n    1: 'Hi ' + d.first_name + ', we\\'re sorry your last experience wasn\\'t perfect. We\\'d love another chance. \\u2013 ' + d.company_name,\n    2: 'Hi ' + d.first_name + ', we\\'ve taken your feedback to heart. Book anytime! \\u2013 ' + d.company_name,\n    3: 'Hi ' + d.first_name + ', final outreach \\u2014 we\\'d love to earn your trust back. Call anytime. \\u2013 ' + d.company_name,\n  },\n  dormant_6mo: {\n    1: 'Hi ' + d.first_name + ', it\\'s been a while since your last ' + d.service_type + ' service! Time for a maintenance check? \\u2013 ' + d.company_name,\n    2: 'Hi ' + d.first_name + ', regular maintenance keeps things running. We have availability this week. \\u2013 ' + d.company_name,\n    3: 'Hi ' + d.first_name + ', last reminder \\u2014 call or text anytime to schedule. \\u2013 ' + d.company_name,\n  },\n};\nconst message = ((tmpl[d.entry_reason] || {})[n]) || ('Hi ' + d.first_name + ', checking in. \\u2013 ' + d.company_name);\nreturn [{ json: { ...d, message, message_number: n } }];\n"
      },
