    {
      "parameters": {
        "operation": "getAll",
        "tableId": "companies",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "active"
            }
          ]
        }
      },
      "id": "ec7eac67-b964-4acb-b7eb-e17ec0f92dae",
      "name": "Get Active Companies",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst gte = new Date(now.getTime() + 20 * 60 * 60 * 1000).toISOString();\nconst lte = new Date(now.getTime() + 28 * 60 * 60 * 1000).toISOString();\nreturn $input.all().map(item => ({\n  json: {\n    company_id: item.json.id,\n    company_name: item.json.company_name,\n    company_timezone: item.json.timezone || 'America/Denver',\n    gte_time: gte,\n    lte_time: lte,\n  }\n}));"
      },
      "id": "a7271026-dc59-4d47-9e51-726989975d92",
      "name": "Compute Time Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "jobs",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=company_id=eq.{{ $json.company_id }}&status=in.(unassigned,assigned)&scheduled_at=gte.{{ $json.gte_time }}&scheduled_at=lte.{{ $json.lte_time }}"
      },
      "id": "de50c34d-2498-4dc6-b8b9-e501935dcdf9",
      "name": "Get Jobs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        896,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has_id",
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d55ef02c-53a5-4ccb-acc0-c059f659be94",
