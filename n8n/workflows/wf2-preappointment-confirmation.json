      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1792,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "phone",
              "leftValue": "={{ $json.customer_phone }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9455f65a-c872-4f71-9eba-9f231a548b50",
      "name": "Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2016,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const tz = item.json.timezone || 'America/Denver';\n  const date = new Date(item.json.scheduled_at);\n  const formatted = date.toLocaleTimeString('en-US', {\n    timeZone: tz,\n    hour: 'numeric',\n    minute: '2-digit',\n    hour12: true,\n  });\n  return { json: { ...item.json, formatted_time: formatted } };\n});"
      },
      "id": "733152bc-f7bb-4fbf-8404-7c82f2b2e491",
      "name": "Format Time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        0
      ]
    },
    {
      "parameters": {
        "from": "<__PLACEHOLDER_VALUE__Twilio phone number (E.164, e.g. +15005550006)__>",
        "to": "={{ $json.customer_phone }}",
        "message": "=Hi {{ $json.customer_name }}, confirming your {{ $json.service_type }} appointment tomorrow at {{ $json.formatted_time }}. Reply YES to confirm or RESCHEDULE for a new time. \u2013 {{ $json.company_name }}",
        "options": {}
      },
      "id": "4653d5b2-eca5-4250-8c05-205827f8033e",
      "name": "Send Confirmation SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        2464,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
