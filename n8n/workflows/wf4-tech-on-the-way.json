    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst d = $json;\nlet sms_body;\nif (d.maps_link) {\n  sms_body = 'Hi ' + d.first_name + ', ' + d.tech_name +\n    ' is on the way for your ' + d.service_type +\n    ' appointment (est. arrival around ' + d.formatted_time +\n    '). Track here: ' + d.maps_link + ' \u2013 ' + d.company_name;\n} else {\n  sms_body = 'Hi ' + d.first_name + ', ' + d.tech_name +\n    ' is on the way for your ' + d.service_type +\n    ' appointment (est. arrival around ' + d.formatted_time +\n    '). \u2013 ' + d.company_name;\n}\nreturn { json: { ...d, sms_body } };\n"
      },
      "id": "c89fbef8-a096-41aa-8363-b2b3abcfd671",
      "name": "Build SMS Message",
      "type": "n8n-nodes-base.code",
