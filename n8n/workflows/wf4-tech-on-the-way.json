    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst webhook  = $('Tech OTW Webhook').item.json.body;\nconst job      = $('Get Job').item.json;\nconst contact  = $('Get Contact').item.json;\nconst company  = $('Get Company').item.json;\n\nconst lat = (webhook.tech_location_lat || '').toString().trim();\nconst lng = (webhook.tech_location_lng || '').toString().trim();\nconst maps_link = (lat && lng)\n  ? 'https://maps.google.com/?q=' + lat + ',' + lng\n  : '';\n\nconst timezone = (company.timezone || 'America/Denver').toString();\nconst scheduledDate = new Date(job.scheduled_at);\nconst formatted_time = scheduledDate.toLocaleString('en-US', {\n  timeZone: timezone,\n  hour: 'numeric',\n  minute: '2-digit',\n  hour12: true,\n});\n\nconst contactName = (contact.name || '').toString();\nconst first_name = contactName.split(' ')[0] || contactName;\n\nreturn {\n  json: {\n    first_name,\n    maps_link,\n    formatted_time,\n    tech_name:      (webhook.tech_name        || '').toString(),\n    company_name:   (company.name     || '').toString(),\n    service_type:   (job.service_type         || '').toString(),\n    customer_phone: (contact.phone            || '').toString(),\n    company_id:     (webhook.company_id       || '').toString(),\n    job_id:         (webhook.job_id           || '').toString(),\n  },\n};\n"
      },
      "id": "cdf1b53f-73d9-4ec4-86b4-bb4e03c4ed09",
