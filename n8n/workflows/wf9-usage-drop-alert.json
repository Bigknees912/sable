    {
      "parameters": {
        "operation": "getAll",
        "tableId": "usage_weekly",
        "limit": 5,
        "orderBy": "week_start.desc",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "company_id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            },
            {
              "keyName": "week_start",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ weeks: 5 }).toFormat(\"yyyy-MM-dd\") }}"
            }
          ]
        }
      },
      "id": "a199547a-5dfc-44cf-adea-2b2b7a54ebec",
      "name": "Get Usage Weekly",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        896,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const allRows = $input.all().map(function(i) { return i.json; }).filter(function(r) { return !!r.week_start; });\nconst company = $('Batch Companies').first().json;\nconst threshold = ($('Set Threshold').first().json.drop_threshold_pct) || 40;\nconst alertLog = company.usage_drop_alert_log || null;\n\nif (allRows.length < 5) {\n  return [{ json: {\n    company_id: company.id,\n    company_name: company.name,\n    should_skip: true,\n    drop_pct: 0,\n    avg_calls: 0,\n    avg_jobs: 0,\n    this_week_calls: 0,\n    this_week_jobs: 0,\n    current_week_start: '',\n    usage_drop_alert_log: alertLog,\n    threshold: threshold,\n  }}];\n}\n\nconst current = allRows[0];\nconst prior = allRows.slice(1, 5);\nvar sumCalls = 0;\nvar sumJobs = 0;\nfor (var pi = 0; pi < prior.length; pi++) {\n  sumCalls += (prior[pi].call_count || 0);\n  sumJobs += (prior[pi].job_count || 0);\n}\nconst avg_calls = sumCalls / 4;\nconst avg_jobs = sumJobs / 4;\nconst this_week_calls = current.call_count || 0;\nconst this_week_jobs = current.job_count || 0;\nconst call_drop_pct = avg_calls > 0 ? (avg_calls - this_week_calls) / avg_calls * 100 : 0;\nconst job_drop_pct = avg_jobs > 0 ? (avg_jobs - this_week_jobs) / avg_jobs * 100 : 0;\nconst drop_pct = call_drop_pct > job_drop_pct ? call_drop_pct : job_drop_pct;\n\nreturn [{ json: {\n  company_id: company.id,\n  company_name: company.name,\n  should_skip: false,\n  drop_pct: drop_pct,\n  avg_calls: avg_calls,\n  avg_jobs: avg_jobs,\n  this_week_calls: this_week_calls,\n  this_week_jobs: this_week_jobs,\n  current_week_start: current.week_start,\n  usage_drop_alert_log: alertLog,\n  threshold: threshold,\n}}];"
      },
      "id": "1ef72437-dd97-4d70-84c8-b8ea79185a67",
      "name": "Compute Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
