      "id": "ec4a733c-30c7-4259-aa1f-85d87ffa1d28",
      "name": "Drop >= Threshold?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1568,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst alertLog = item.usage_drop_alert_log;\nconst drop_pct = item.drop_pct;\nconst shouldAlert = (function() {\n  if (!alertLog || !alertLog.last_alerted_week) { return true; }\n  const lastDate = new Date(alertLog.last_alerted_week);\n  const now = new Date();\n  const daysDiff = (now.getTime() - lastDate.getTime()) / (1000 * 60 * 60 * 24);\n  if (daysDiff < 14 && drop_pct <= (alertLog.last_alerted_drop || 0)) { return false; }\n  return true;\n})();\nreturn [{ json: {\n  company_id: item.company_id,\n  company_name: item.company_name,\n  should_alert: shouldAlert,\n  drop_pct: drop_pct,\n  avg_calls: item.avg_calls,\n  avg_jobs: item.avg_jobs,\n  this_week_calls: item.this_week_calls,\n  this_week_jobs: item.this_week_jobs,\n  current_week_start: item.current_week_start,\n  threshold: item.threshold,\n}}];"
      },
      "id": "ef4cb7b9-b653-4b97-ab00-3af463ca3740",
      "name": "Suppression Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
