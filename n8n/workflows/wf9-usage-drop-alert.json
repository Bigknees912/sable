      "id": "4ddd7865-1a81-4cb3-8c9c-b4902730c467",
      "name": "Should Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2016,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst avgCalls = Math.round(item.avg_calls);\nconst avgJobs = Math.round(item.avg_jobs);\nconst dropPct = Math.round(item.drop_pct);\nconst LF = String.fromCharCode(10);\n\nconst emailBody = 'Company: ' + item.company_name + LF + LF +\n  'Normal weekly average:' + LF +\n  '  Calls: ' + avgCalls + LF +\n  '  Jobs: ' + avgJobs + LF + LF +\n  'This week actual:' + LF +\n  '  Calls: ' + item.this_week_calls + LF +\n  '  Jobs: ' + item.this_week_jobs + LF + LF +\n  'Drop: ' + dropPct + '% below their normal pattern.' + LF + LF +\n  'Suggestion: Consider a personal check-in with ' + item.company_name + ' \u2014 this may signal dissatisfaction or a business problem on their end, worth a human phone call.';\n\nconst slackText = '*Usage drop alert: ' + item.company_name + '*' + LF +\n  'Normal avg: ' + avgCalls + ' calls / ' + avgJobs + ' jobs per week' + LF +\n  'This week: ' + item.this_week_calls + ' calls / ' + item.this_week_jobs + ' jobs' + LF +\n  'Drop: ' + dropPct + '% below normal' + LF +\n  'Consider a personal check-in \u2014 worth a human phone call.';\n\nreturn [{ json: {\n  company_id: item.company_id,\n  company_name: item.company_name,\n  email_subject: 'Usage drop alert: ' + item.company_name,\n  email_body: emailBody,\n  slack_text: slackText,\n  drop_pct: item.drop_pct,\n  current_week_start: item.current_week_start,\n}}];"
      },
