{
  "name": "Website Lead Capture + 2-Day Follow-up",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Get a Free Demo of Sable",
        "formDescription": "Tell us a bit about your business \u2014 we'll be in touch within 24 hours.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Business Name",
              "fieldName": "business_name",
              "requiredField": true
            },
            {
              "fieldLabel": "Your Name",
              "fieldName": "contact_name",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone Number",
              "fieldName": "phone",
              "placeholder": "e.g. (720) 555-0100"
            },
            {
              "fieldLabel": "Email Address",
              "fieldType": "email",
              "fieldName": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Trade Type",
              "fieldType": "dropdown",
              "fieldName": "trade_type",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Plumbing"
                  },
                  {
                    "option": "HVAC"
                  },
                  {
                    "option": "Electrical"
                  },
                  {
                    "option": "General Contracting"
                  },
                  {
                    "option": "Other"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Number of trucks / technicians",
              "fieldType": "number",
              "fieldName": "team_size"
            },
            {
              "fieldLabel": "What's your biggest scheduling or call-answering headache right now?",
              "fieldType": "textarea",
              "fieldName": "pain_point",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "path": "sable-demo-request",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks! We\u2019ll be in touch within 24 hours. \u2013 The Sable Team"
            }
          }
        }
      },
