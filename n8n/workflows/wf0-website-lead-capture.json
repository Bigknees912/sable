            {
              "name": "subject",
              "value": "Quick follow-up on your Sable demo request"
            },
            {
              "name": "text",
              "value": "=Hi {{ $('Carry Data').item.json.contact_name }},\n\nJust following up on your note about {{ $('Carry Data').item.json.pain_point }} \u2014 still looking for a way to stop missing calls?\n\nHappy to show you a 5-minute demo whenever works for you, no pressure either way. Just reply to this email and we\u2019ll find a time.\n\n\u2013 Ryan\nFounder, Sable\nrunsable.com"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
