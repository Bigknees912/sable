        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "Sable Leads <__PLACEHOLDER_VALUE__Resend From header, e.g. Sable <alerts@runsable.com>__>"
            },
            {
              "name": "to",
              "value": "<__PLACEHOLDER_VALUE__Your notification email address__>"
            },
            {
              "name": "subject",
              "value": "=New demo request: {{ $json.business_name }} \u2014 {{ $json.trade_type }}"
            },
            {
              "name": "text",
              "value": "=New lead from your website!\n\nBusiness: {{ $json.business_name }}\nContact: {{ $json.contact_name }}\nPhone: {{ $json.phone }}\nEmail: {{ $json.email }}\nTrade: {{ $json.trade_type }}\nTeam size: {{ $json.team_size }} trucks/technicians\n\nPain point:\n\"{{ $json.pain_point }}\"\n\nSource: Website survey\n\n\u2013 Sable"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
