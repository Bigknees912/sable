      "parameters": {
        "jsCode": "\nconst bundle = $('Set Bundle').item.json;\nconst trigger = $('Stripe Trigger').item.json;\nconst details = trigger.data.object.cancellation_details;\nconst cancellation_reason = (details && details.reason) ? details.reason.toString() : 'unknown';\nreturn [{ json: { ...bundle, cancellation_reason } }];\n"
      },
