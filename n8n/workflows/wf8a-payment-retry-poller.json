    {
      "parameters": {
        "jsCode": "const company = $input.first().json;\nconst queue = $('Batch Queue Rows').first().json;\n\nconst companyFound = !!(company && company.id);\nconst companyActive = companyFound && company.status === 'active';\n\nlet route = 2;\nif (!companyFound) { route = 0; }\nelse if (companyActive) { route = 1; }\n\nconst existingLog = (companyFound && Array.isArray(company.payment_failure_log))\n  ? company.payment_failure_log : [];\n\nconst attempt = queue.attempt_number || 1;\n\nreturn [{\n  json: {\n    queue_row_id: queue.id || '',\n    invoice_id: queue.invoice_id || '',\n    company_id: queue.company_id || '',\n    customer_email: queue.customer_email || company.contact_email || '',\n    amount_due: queue.amount_due || 0,\n    attempt_number: attempt,\n    company_found: companyFound,\n    company_active: companyActive,\n    company_status: company.status || '',\n    existing_failure_log: existingLog,\n    route: route,\n  }\n}];"
      },
      "id": "06d891b3-0b02-4e5f-b17e-3f47a29730a0",
      "name": "Evaluate Company",
