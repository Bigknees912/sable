      "id": "ec63c3a4-65fd-4cf0-bc1e-93c76b053975",
      "name": "Stripe Retry Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1568,
        576
      ]
