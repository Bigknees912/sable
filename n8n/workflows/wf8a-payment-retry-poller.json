      "parameters": {
        "jsCode": "const bundle = $input.first().json;\nconst existingLog = Array.isArray(bundle.existing_failure_log) ? bundle.existing_failure_log : [];\nconst entry = { event: 'auto_resolved', invoice_id: bundle.invoice_id, timestamp: new Date().toISOString() };\nreturn [{\n  json: {\n    company_id: bundle.company_id,\n    queue_row_id: bundle.queue_row_id,\n    payment_failure_log_json: JSON.stringify(existingLog.concat([entry])),\n  }\n}];"
