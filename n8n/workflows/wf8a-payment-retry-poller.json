    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst bundle = $('Evaluate Company').item.json;\n\nconst statusCode = resp.statusCode || 0;\nconst body = resp.body || {};\n\nlet result_type = 'failed';\nif (statusCode === 200) {\n  const piStatus = (body.payment_intent && body.payment_intent.status) || '';\n  result_type = piStatus === 'requires_action' ? '3ds' : 'success';\n}\n\nconst resultRouteMap = { success: 0, '3ds': 1, failed: 2 };\nconst result_route = (resultRouteMap[result_type] !== undefined) ? resultRouteMap[result_type] : 2;\n\nconst attempt = bundle.attempt_number || 1;\nconst fail_route = Math.min(attempt - 1, 2);\nconst next_attempt = attempt + 1;\n\nreturn [{\n  json: {\n    queue_row_id: bundle.queue_row_id,\n    invoice_id: bundle.invoice_id,\n    company_id: bundle.company_id,\n    customer_email: bundle.customer_email,\n    amount_due: bundle.amount_due,\n    attempt_number: attempt,\n    existing_failure_log: bundle.existing_failure_log,\n    stripe_status_code: statusCode,\n    result_type: result_type,\n    result_route: result_route,\n    fail_route: fail_route,\n    next_attempt: next_attempt,\n  }\n}];"
      },
      "id": "e690f2e0-9f58-4d95-b574-5363cbb4ca39",
