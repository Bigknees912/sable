    {
      "parameters": {
        "jsCode": "const company = $input.first().json;\nconst body = $('Extract Body').first().json;\n\nconst plan = (company.plan || '').toLowerCase();\nconst techCount = parseInt(body.technician_count, 10) || 0;\n\nvar seat_limit = 0;\nif (plan === 'starter') { seat_limit = 1; }\nelse if (plan === 'growth') { seat_limit = 5; }\nelse if (plan === 'pro') { seat_limit = 999; }\nelse { seat_limit = 0; }\n\nif (plan === 'pro' || seat_limit === 0 || seat_limit === 999) {\n  return [{ json: { should_nudge: false, reason: 'fleet_or_unknown_plan' } }];\n}\n\nconst threshold = seat_limit - 1;\n\nif (techCount !== threshold) {\n  return [{ json: { should_nudge: false, reason: 'count_not_at_threshold' } }];\n}\n\nconst plan_key = plan + '_' + threshold;\nconst existingNudges = company.seat_nudge_sent || {};\nif (existingNudges[plan_key] === true) {\n  return [{ json: { should_nudge: false, reason: 'already_sent' } }];\n}\n\nreturn [{ json: {\n  should_nudge: true,\n  reason: 'eligible',\n  company_id: company.id,\n  company_name: company.name,\n  owner_email: company.contact_email,\n  plan: plan,\n  plan_key: plan_key,\n  seat_limit: seat_limit,\n  threshold: threshold,\n  technician_count: techCount,\n  existing_nudges: existingNudges,\n}}];"
      },
      "id": "da8eb177-3ef6-4978-878d-7fce6c4120c7",
      "name": "Evaluate Nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.should_nudge }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "416afa23-07af-4e99-b60d-9b470c00f379",
      "name": "Should Nudge?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1344,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst planLabel = ({ starter: 'Solo', growth: 'Team', pro: 'Fleet' })[item.plan] || item.plan;\nconst LF = String.fromCharCode(10);\n\nconst subject = \"You're almost at your \" + planLabel + \" plan limit\";\nconst body = \"Hi \" + item.company_name + \",\" + LF + LF +\n  \"Your team now has \" + item.technician_count + \" technicians \\u2014 just 1 away from your \" +\n  planLabel + \" plan's \" + item.seat_limit + \"-seat limit.\" + LF + LF +\n  \"Upgrading to Fleet unlocks unlimited seats, plus:\" + LF +\n  \"  \\u2022 Advanced reporting & analytics\" + LF +\n  \"  \\u2022 Priority support\" + LF +\n  \"  \\u2022 Multi-location management\" + LF + LF +\n  \"Upgrade now before you hit the wall:\" + LF +\n  \"https://app.example.com/plan?upgrade=true\";\n\nconst nudge_json = JSON.stringify(Object.assign({}, item.existing_nudges, {\n  [item.plan_key]: true,\n  sent_at: new Date().toISOString(),\n}));\n\nreturn [{ json: {\n  company_id: item.company_id,\n  owner_email: item.owner_email,\n  company_name: item.company_name,\n  plan: item.plan,\n  plan_key: item.plan_key,\n  seat_limit: item.seat_limit,\n  threshold: item.threshold,\n  email_subject: subject,\n  email_body: body,\n  nudge_json: nudge_json,\n}}];"
      },
      "id": "b4009aa1-6c95-4774-b69a-4a8c93150d83",
      "name": "Build Upsell Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
