        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const existing = (item.json.customer_tags || '').split(',').map(t => t.trim()).filter(Boolean);\n  if (!existing.includes('loyal_customer')) {\n    existing.push('loyal_customer');\n  }\n  return { json: { ...item.json, new_tags: existing.join(',') } };\n});"
