        "jsCode": "const bundle = $('Combine Bundle').first().json;\nconst existingLog = Array.isArray(bundle.existing_failure_log) ? bundle.existing_failure_log : [];\nconst newEntry = {\n  event: 'initial_failure',\n  invoice_id: bundle.invoice_id,\n  timestamp: new Date().toISOString(),\n  email_sent: true,\n  attempt: 1,\n};\nreturn [{ json: { company_id: bundle.company_id, payment_failure_log: existingLog.concat([newEntry]) } }];"
