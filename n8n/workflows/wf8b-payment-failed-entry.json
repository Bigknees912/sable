    {
      "parameters": {
        "jsCode": "const company = $input.first().json;\nconst event = $('Extract Event Fields').first().json;\n\nconst rawEmail = (event.customer_email && event.customer_email.length > 0)\n  ? event.customer_email\n  : (company.contact_email || '');\n\nconst cents = event.amount_due || 0;\nconst dollars = Math.floor(cents / 100);\nconst remainder = cents % 100;\nconst centsStr = remainder < 10 ? '0' + remainder : '' + remainder;\nconst amountFormatted = '$' + dollars + '.' + centsStr;\n\nconst existingLog = Array.isArray(company.payment_failure_log)\n  ? company.payment_failure_log\n  : [];\n\nreturn [{\n  json: {\n    company_id: company.id || '',\n    company_name: company.name || '',\n    existing_failure_log: existingLog,\n    invoice_id: event.invoice_id || '',\n    customer_id: event.customer_id || '',\n    customer_email: rawEmail,\n    amount_due: cents,\n    amount_formatted: amountFormatted,\n    attempt_count: event.attempt_count || 1,\n  }\n}];"
      },
      "id": "b08afaea-20a0-46fd-96ff-2c06533a02d7",
